rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /votes/tally {
      allow read: if true;
      allow update: if request.resource.data.keys().hasOnly(['boy', 'girl'])
        && (
          (request.resource.data.boy == resource.data.boy + 1 && request.resource.data.girl == resource.data.girl)
          || (request.resource.data.girl == resource.data.girl + 1 && request.resource.data.boy == resource.data.boy)
        );
      allow create: if request.resource.data.keys().hasOnly(['boy', 'girl'])
        && request.resource.data.boy is int && request.resource.data.girl is int;
      allow delete: if false;
    }

    match /predictions/{predictionId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(
        ['name', 'firstWord', 'lookLike', 'spoil', 'owl', 'closest', 'submittedAt']
      )
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update, delete: if false;
    }

    match /voteRecords/{voteRecordId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'team', 'votedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.team in ['boy', 'girl'];
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 500;
      allow update, delete: if false;
    }
  }
}
